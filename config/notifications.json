{
  "_comment": "SmartContractAudit Notification Configuration v1.0.0",
  "_security": "NEVER commit real webhook URLs, tokens, or API keys. Use GitHub Secrets.",
  "_usage": "Set NOTIFICATIONS_CONFIG as a GitHub Secret with real values for production.",

  "email": {
    "enabled": false,
    "recipients": "${NOTIFY_EMAIL_RECIPIENTS}",
    "severity": ["critical", "high"]
  },
  "slack": {
    "enabled": false,
    "webhook": "${SLACK_WEBHOOK_URL}",
    "channel": "#security-alerts",
    "username": "Audit Bot",
    "iconEmoji": ":shield:",
    "severity": ["critical", "high", "medium"]
  },
  "telegram": {
    "enabled": false,
    "botToken": "${TELEGRAM_BOT_TOKEN}",
    "chatId": "${TELEGRAM_CHAT_ID}",
    "severity": ["critical"]
  },
  "discord": {
    "enabled": false,
    "webhook": "${DISCORD_WEBHOOK_URL}",
    "severity": ["critical", "high"]
  },
  "webhook": {
    "enabled": false,
    "url": "${CUSTOM_WEBHOOK_URL}",
    "method": "POST",
    "severity": ["critical", "high", "medium", "low"]
  }
}