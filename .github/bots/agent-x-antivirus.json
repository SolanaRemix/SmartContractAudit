{
  "name": "smartbrain-agent-x",
  "version": "1.0.0",
  "description": "SmartBrain Agent X - Antivirus & Security Scanner BOT",
  "type": "security",
  "config": {
    "dryRun": true,
    "autoQuarantine": false,
    "scanDepth": "deep",
    "suspiciousPatterns": {
      "commands": [
        "rm\\s+-rf\\s+/",
        "curl.*\\|\\s*(ba)?sh",
        "wget.*\\|\\s*(ba)?sh",
        "eval\\s*[\\(`]",
        "exec\\s*\\(",
        "system\\s*\\(",
        "__import__\\s*\\(",
        "base64\\s+(-d|--decode)",
        "openssl\\s+enc",
        "nc\\s+-[nl]",
        "chmod\\s+[0-7]*7",
        "sudo\\s+"
      ],
      "secretPatterns": [
        "(?i)api[_-]?key",
        "(?i)access[_-]?token",
        "(?i)secret[_-]?key",
        "(?i)private[_-]?key",
        "(?i)password\\s*[=:]\\s*['\"]?\\S+['\"]?",
        "(?i)bearer\\s+[A-Za-z0-9_\\-\\.]+",
        "(?i)authorization\\s*[=:]\\s*['\"]?\\S+['\"]?"
      ],
      "malwareSignatures": [
        "base64.*eval",
        "fromCharCode",
        "unescape.*eval",
        "document\\.write.*script",
        "atob\\s*\\(",
        "String\\.fromCharCode"
      ]
    },
    "fileTypes": {
      "code": ["js", "jsx", "ts", "tsx", "py", "rb", "php", "java", "go", "rs"],
      "config": ["json", "yml", "yaml", "toml", "env"],
      "scripts": ["sh", "bash", "ps1", "zsh"],
      "contracts": ["sol"],
      "archives": ["zip", "tar", "gz", "tgz", "bz2", "apk"]
    },
    "quarantine": {
      "enabled": true,
      "path": ".quarantine",
      "createReport": true,
      "notifyOnFindings": true,
      "autoExpireDays": 30,
      "maxQuarantineSize": "50MB"
    },
    "bypass": {
      "enabled": true,
      "label": "security-bypass",
      "requireAdminApproval": true,
      "auditLog": true
    }
  },
  "triggers": {
    "events": ["push", "pull_request", "schedule"],
    "schedule": "0 2 * * *",
    "branches": ["main", "develop"],
    "excludePaths": [".quarantine/**", "*.md", "LICENSE", "docs/**"]
  },
  "severity": {
    "critical": {
      "action": "block",
      "notify": true,
      "bypassLabel": "security-bypass-critical",
      "bypassRequiresAdmin": true
    },
    "high": {
      "action": "warn",
      "notify": true
    },
    "medium": {
      "action": "log",
      "notify": false
    },
    "low": {
      "action": "log",
      "notify": false
    }
  },
  "reporting": {
    "format": "json",
    "outputPath": ".quarantine/scan-report.json",
    "includeHashes": false,
    "_hashNote": "Set to false to prevent file fingerprint leakage in reports",
    "includePaths": true,
    "redactSecrets": true,
    "maxReportSize": "10MB",
    "retentionDays": 90
  }
}